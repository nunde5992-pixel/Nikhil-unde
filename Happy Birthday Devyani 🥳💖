<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday 🎂</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
    background: linear-gradient(135deg, #ff758c, #ff7eb3, #7b61ff);
    color: white;
    text-align: center;
}

/* Background stars */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image:
        radial-gradient(circle, white 1px, transparent 1px);
    background-size: 45px 45px;
    opacity: 0.25;
    pointer-events: none;
}

/* Main section */
.hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 30px 15px;
}

.small {
    font-size: 20px;
    letter-spacing: 4px;
    animation: fadeIn 2s;
}

h1 {
    font-size: clamp(45px, 12vw, 100px);
    margin: 15px 0;
    text-shadow: 0 0 15px white, 0 0 35px #ffeb3b;
    animation: glow 2s infinite alternate;
}

.name {
    font-size: clamp(30px, 8vw, 65px);
    font-weight: bold;
    color: #fff176;
}

.message {
    max-width: 650px;
    font-size: 20px;
    line-height: 1.6;
    margin: 25px auto;
}

/* Button */
button {
    border: none;
    padding: 16px 30px;
    border-radius: 50px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    background: white;
    color: #ff4f81;
    box-shadow: 0 0 20px rgba(255,255,255,.7);
    transition: .3s;
}

button:hover {
    transform: scale(1.1);
}

/* Surprise */
#surprise {
    display: none;
    margin-top: 25px;
    font-size: 24px;
    animation: pop .7s ease;
}

/* Photos */
.gallery {
    padding: 70px 20px;
}

.gallery h2 {
    font-size: 40px;
    margin-bottom: 35px;
}

.photos {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    max-width: 1000px;
    margin: auto;
}

.photo-card {
    width: 250px;
    height: 300px;
    background: white;
    padding: 10px;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,.3);
    transform: rotate(-2deg);
    transition: .4s;
}

.photo-card:nth-child(2) {
    transform: rotate(3deg);
}

.photo-card:nth-child(3) {
    transform: rotate(-4deg);
}

.photo-card:hover {
    transform: rotate(0deg) scale(1.08);
}

.photo-card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    border-radius: 14px;
}

.photo-card p {
    color: #ff4f81;
    font-weight: bold;
    margin-top: 8px;
}

/* Balloons */
.balloon {
    position: fixed;
    bottom: -120px;
    width: 55px;
    height: 70px;
    border-radius: 50%;
    animation: fly 9s linear infinite;
    z-index: -1;
}

.balloon::after {
    content: "";
    position: absolute;
    width: 2px;
    height: 100px;
    background: white;
    left: 50%;
    top: 68px;
}

.b1 { left: 8%; background: #ff5252; animation-delay: 1s; }
.b2 { left: 25%; background: #40c4ff; animation-delay: 4s; }
.b3 { left: 50%; background: #69f0ae; animation-delay: 2s; }
.b4 { left: 75%; background: #ffd740; animation-delay: 5s; }
.b5 { left: 90%; background: #e040fb; animation-delay: 3s; }

/* Confetti */
.confetti {
    position: fixed;
    top: -20px;
    width: 10px;
    height: 18px;
    animation: fall 5s linear infinite;
}

.c1 { left: 10%; background: #ffeb3b; animation-delay: .5s; }
.c2 { left: 30%; background: #00e5ff; animation-delay: 2s; }
.c3 { left: 50%; background: #ff4081; animation-delay: 1s; }
.c4 { left: 70%; background: #76ff03; animation-delay: 3s; }
.c5 { left: 90%; background: #fff; animation-delay: 1.5s; }

footer {
    padding: 30px;
    font-size: 16px;
}

/* Animations */
@keyframes glow {
    from {
        transform: scale(1);
        text-shadow: 0 0 10px white, 0 0 20px #ffeb3b;
    }
    to {
        transform: scale(1.04);
        text-shadow: 0 0 20px white, 0 0 50px #ffeb3b;
    }
}

@keyframes fly {
    0% {
        transform: translateY(0) rotate(0);
    }
    100% {
        transform: translateY(-120vh) rotate(15deg);
    }
}

@keyframes fall {
    0% {
        transform: translateY(-20px) rotate(0);
    }
    100% {
        transform: translateY(110vh) rotate(720deg);
    }
}

@keyframes pop {
    0% {
        transform: scale(0);
    }
    100% {
        transform: scale(1);
    }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}
</style>
</head>

<body>

<!-- Balloons -->
<div class="balloon b1"></div>
<div class="balloon b2"></div>
<div class="balloon b3"></div>
<div class="balloon b4"></div>
<div class="balloon b5"></div>

<!-- Confetti -->
<div class="confetti c1"></div>
<div class="confetti c2"></div>
<div class="confetti c3"></div>
<div class="confetti c4"></div>
<div class="confetti c5"></div>

<section class="hero">

    <div class="small">✨ TODAY IS A SPECIAL DAY ✨</div>

    <!-- CHANGE THE NAME HERE -->
    <h1>HAPPY BIRTHDAY 🎂</h1>

    <div class="name">YOUR NAME ❤️</div>

    <p class="message">
        Wishing you a day filled with happiness, laughter,
        amazing memories and lots of cake! 🥳🎂
    </p>

    <button onclick="showSurprise()">
        🎁 OPEN YOUR SURPRISE
    </button>

    <div id="surprise">
        🎉 YOU ARE AWESOME! 🎉<br>
        Hope your birthday is absolutely unforgettable! ❤️
    </div>

</section>


<section class="gallery">

    <h2>📸 Memories</h2>

    <div class="photos">

        <!-- CHANGE THESE PHOTO NAMES -->
        <div class="photo-card">
            <img src="photo1.jpg">
            <p>✨ Beautiful Memory</p>
        </div>

        <div class="photo-card">
            <img src="photo2.jpg">
            <p>❤️ Best Moments</p>
        </div>

        <div class="photo-card">
            <img src="photo3.jpg">
            <p>🥳 Good Times</p>
        </div>

    </div>

</section>


<footer>
    Made with ❤️ for the birthday star ✨
</footer>


<script>
function showSurprise() {
    document.getElementById("surprise").style.display = "block";

    // Extra confetti
    for (let i = 0; i < 80; i++) {
        let confetti = document.createElement("div");

        confetti.style.position = "fixed";
        confetti.style.width = "8px";
        confetti.style.height = "15px";
        confetti.style.background =
            ["#ffeb3b", "#ff4081", "#00e5ff", "#76ff03", "#ffffff"]
            [Math.floor(Math.random() * 5)];

        confetti.style.left = Math.random() * 100 + "vw";
        confetti.style.top = "-20px";
        confetti.style.zIndex = "999";

        document.body.appendChild(confetti);

        let duration = 2 + Math.random() * 4;

        confetti.animate(
            [
                { transform: "translateY(0) rotate(0deg)" },
                { transform: "translateY(110vh) rotate(720deg)" }
            ],
            {
                duration: duration * 1000,
                easing: "linear"
            }
        );

        setTimeout(() => confetti.remove(), duration * 1000);
    }
}
</script>

</body>
</html>